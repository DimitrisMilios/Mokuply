{
  "name": "mokuply-mcp",
  "version": "1.0.0",
  "description": "Cross-platform Model Context Protocol (MCP) server for Mokuply - automated App Store & Google Play screenshots with AI",
  "type": "module",
  "bin": {
    "mokuply-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node test_server.mjs",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts"
  },
  "keywords": [
    "mcp",
    "mokuply",
    "app-store",
    "google-play",
    "screenshots",
    "ai",
    "claude",
    "antigravity"
  ],
  "author": "Mokuply Authors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "jszip": "^3.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
